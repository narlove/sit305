<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".fragments.TaskFragment">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/promptTaskBannerCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:visibility="gone"
        app:cardBackgroundColor="#E3F2FD"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp"
        app:strokeColor="#2196F3"
        app:strokeWidth="1dp"
        tools:visibility="visible">

        <TextView
            android:id="@+id/promptTaskBannerText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawablePadding="12dp"
            android:gravity="center_vertical"
            android:padding="12dp"
            android:text="This task was generated by AI."
            android:textColor="#0D47A1"
            android:textSize="18sp"
            app:drawableStartCompat="@drawable/baseline_bookmarks_24"
            app:drawableTint="#2196F3" />

    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/taskTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Task title loading..."
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/taskDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="A brief description of this task is currently loading... it should be ready soon!"
        android:textSize="14sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- QuestionSet 1 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="4dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Question 1"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/questionText1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Question 1 loading..." />

                    <RadioGroup
                        android:id="@+id/optionsGroup1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp">

                        <RadioButton
                            android:id="@+id/option1a"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Option A" />

                        <RadioButton
                            android:id="@+id/option1b"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Option B" />

                        <RadioButton
                            android:id="@+id/option1c"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Option C" />
                    </RadioGroup>

                    <Button
                        android:id="@+id/hintButton1"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:text="request hint" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- QuestionSet 2 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="4dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Question 2"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/questionText2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Question 2 loading..." />

                    <RadioGroup
                        android:id="@+id/optionsGroup2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp">

                        <RadioButton
                            android:id="@+id/option2a"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Option A" />

                        <RadioButton
                            android:id="@+id/option2b"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Option B" />

                        <RadioButton
                            android:id="@+id/option2c"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Option C" />
                    </RadioGroup>

                    <Button
                        android:id="@+id/hintButton2"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:text="request hint" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- QuestionSet 3 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="4dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Question 3"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/questionText3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Question 3 loading..." />

                    <RadioGroup
                        android:id="@+id/optionsGroup3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp">

                        <RadioButton
                            android:id="@+id/option3a"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Option A" />

                        <RadioButton
                            android:id="@+id/option3b"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Option B" />

                        <RadioButton
                            android:id="@+id/option3c"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Option C" />
                    </RadioGroup>

                    <Button
                        android:id="@+id/hintButton3"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:text="request hint" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/submitButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:backgroundTint="@color/btn_good_green"
        android:text="Submit"
        android:textColor="@color/white" />

    <Button
        android:id="@+id/backButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:backgroundTint="@color/btn_go_back"
        android:text="Back"
        android:textColor="@color/white" />

</LinearLayout>