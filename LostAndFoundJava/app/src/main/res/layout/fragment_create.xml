<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".fragments.CreateFragment">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/external"
                android:layout_marginBottom="@dimen/external"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/textView"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:text="Post type:"
                    android:textSize="18sp" />

                <RadioGroup
                    android:id="@+id/postTypeRadioGroup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkedButton="@id/lostRadio"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/lostRadio"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="12dp"
                        android:layout_marginRight="6dp"
                        android:text="Lost" />

                    <RadioButton
                        android:id="@+id/foundRadio"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="6dp"
                        android:layout_marginRight="12dp"
                        android:text="Found" />
                </RadioGroup>

            </LinearLayout>

            <TextView
                android:id="@+id/textView2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/external"
                android:layout_marginBottom="@dimen/internal"
                android:text="Post title:"
                android:textSize="18sp" />

            <EditText
                android:id="@+id/nameEntry"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="@dimen/internal"
                android:layout_marginBottom="@dimen/external"
                android:ems="10"
                android:inputType="text"
                android:text="Post title..." />

            <TextView
                android:id="@+id/textView3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/external"
                android:layout_marginBottom="@dimen/internal"
                android:text="Contact phone number:"
                android:textSize="18sp" />

            <EditText
                android:id="@+id/phoneEntry"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="@dimen/internal"
                android:layout_marginBottom="@dimen/external"
                android:ems="10"
                android:inputType="phone"
                android:text="0447 568 965" />

            <TextView
                android:id="@+id/textView4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/external"
                android:layout_marginBottom="@dimen/internal"
                android:text="Description:"
                android:textSize="18sp" />

            <EditText
                android:id="@+id/descriptionEntry"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="@dimen/internal"
                android:layout_marginBottom="@dimen/external"
                android:ems="10"
                android:gravity="start|top"
                android:inputType="textMultiLine"
                android:text="Enter description here..." />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/external"
                android:layout_marginBottom="@dimen/internal"
                android:text="Date:"
                android:textSize="18sp" />

            <Button
                android:id="@+id/selectDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/internal"
                android:layout_marginBottom="@dimen/external"
                android:text="Select date (none yet selected)" />

            <TextView
                android:id="@+id/textView6"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/external"
                android:layout_marginBottom="@dimen/internal"
                android:text="Location:"
                android:textSize="18sp" />

            <EditText
                android:id="@+id/locationEntry"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="@dimen/internal"
                android:layout_marginBottom="@dimen/external"
                android:ems="10"
                android:inputType="text"
                android:text="Rough item location..." />

            <Button
                android:id="@+id/selectCurrentLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/internal"
                android:layout_marginBottom="@dimen/external"
                android:text="Set location as current location" />

            <TextView
                android:id="@+id/textView7"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/external"
                android:layout_marginBottom="@dimen/internal"
                android:text="Image upload:"
                android:textSize="18sp" />

            <Button
                android:id="@+id/selectImage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/internal"
                android:layout_marginBottom="@dimen/external"
                android:text="Select image (none yet selected)" />

            <TextView
                android:id="@+id/textView8"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/external"
                android:layout_marginBottom="@dimen/internal"
                android:text="Post category:"
                android:textSize="18sp" />

            <Spinner
                android:id="@+id/categoryEntry"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="@dimen/internal"
                android:layout_marginBottom="@dimen/external" />

            <Button
                android:id="@+id/submitButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/external"
                android:layout_marginBottom="@dimen/external"
                android:text="Submit" />

        </LinearLayout>
    </ScrollView>

</FrameLayout>